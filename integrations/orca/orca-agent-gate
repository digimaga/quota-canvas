def command_code_needs_model(args):
    first_word = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            if first_word is None and index + 1 < len(args):
                first_word = args[index + 1]
            break
        if arg == "--model" or arg.startswith("--model=") or arg.startswith("-m"):
            return False
        if arg in COMMAND_CODE_REQUIRED_VALUE_OPTIONS:
            if index + 1 < len(args):
                index += 1
        elif arg in COMMAND_CODE_OPTIONAL_VALUE_OPTIONS:
            if index + 1 < len(args) and not args[index + 1].startswith("-"):
                index += 1
        elif not arg.startswith("-") and first_word is None:
            first_word = arg
        index += 1
    return first_word not in COMMAND_CODE_SUBCOMMANDS


def model_args(args, config, force):
    allowed = config.get("devin_allowed_models", DEFAULT_MODELS)
    default = config.get("devin_model", "swe-2-high")
    if not isinstance(allowed, list) or not all(isinstance(x, str) for x in allowed) or not isinstance(default, str):
        raise ValueError("devin_model または devin_allowed_models が不正です")
    models = []
    index = 0
    while index < len(args) and args[index] != "--":
        arg = args[index]
        if arg == "--model":
            if index + 1 >= len(args) or args[index + 1].startswith("-"):
                raise ValueError("--model に値が必要です")
            else:
                index += 1
                models.append(args[index])
        elif arg.startswith("--model="):
            model = arg.split("=", 1)[1]
            if not model:
                raise ValueError("--model に値が必要です")
            models.append(model)
        index += 1
    if not models:
        models = [default]
        position = 1 if args and args[0] == "acp" else 0
        args = args[:position] + ["--model", default] + args[position:]
    if not force and any(model not in allowed for model in models):
        return None
    return args


def worker_limits(agent, worker, options, agents):
    caps = []
    keys = set()
    peers = dict(agents)
    peers[agent] = options
    for peer, settings in peers.items():
        if not isinstance(settings, dict):
            continue
        if settings.get("off") is True or settings.get("worker", DEFAULT_WORKERS.get(peer)) != worker:
            continue
        cap = settings.get("cap")
        if cap is not None:
            if isinstance(cap, bool) or not isinstance(cap, int) or cap < 1:
                raise ValueError("cap は 1 以上の整数にしてください")
            caps.append(cap)
        board_keys = settings.get("board_keys", [])
        if (not isinstance(board_keys, list) or
                any(not isinstance(key, str) or not key for key in board_keys) or
                len(set(board_keys)) != len(board_keys)):
            raise ValueError("board_keys は重複のない文字列の配列にしてください")
        keys.update(board_keys)
    return (min(caps) if caps else None), sorted(keys)



def valid_worker(worker):
    return (isinstance(worker, str) and worker != "off" and not worker.startswith("-") and
            re.fullmatch(r"[A-Za-z0-9._-]{1,40}", worker) is not None)


def parse_datetime(value):
    if not isinstance(value, str):
        return None
    value = value.strip()
    if value.endswith(("Z", "z")):
        value = value[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError:
        return None
    return parsed if parsed.tzinfo is not None else parsed.astimezone()


def read_regular_text(path, limit=1024 * 1024):
    # FIFO などで open/read が戻らないのを避ける。通常ファイル以外・上限超過は OSError。
    fd = os.open(str(path), os.O_RDONLY | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(errno.EINVAL, "通常ファイルではありません")
        data = b""
        while len(data) <= limit:
            chunk = os.read(fd, limit + 1 - len(data))
            if not chunk:
                break
            data += chunk
        if len(data) > limit:
            raise OSError(errno.EFBIG, "ファイルが大きすぎます")
        return data.decode("utf-8")
    finally:
        os.close(fd)


def read_verdict(worker):
    result = {"worker": worker, "verdict": "unknown", "reason": "status.json が無い",
              "remaining": None, "resets_at": None, "stale": True, "source": "none"}
    root = HOME / "Library/Application Support/quota-canvas"
    override = os.environ.get("QUOTA_STATUS_PATH")
    paths = [(Path(override), "env")] if override else [(root / "status.json", "local"),
                                                         (root / "remote/status.json", "remote")]
    now = datetime.now(timezone.utc)
    for path, source in paths:
        try:
            data = json.loads(read_regular_text(path))
        except FileNotFoundError:
            continue
        except (OSError, UnicodeError, ValueError, RecursionError):
            result["reason"] = "status.json が読めない"
            continue
        updated = parse_datetime(data.get("updated_at")) if isinstance(data, dict) else None
        if updated is None or now - updated > timedelta(minutes=20) or updated - now >= timedelta(minutes=5):
            result["reason"] = "status.json が古い"
            continue
        routing = data.get("routing")
        if not isinstance(routing, dict):
            result["reason"] = "status.json に routing が無い"
            continue
        workers = routing.get("workers")
        if not isinstance(workers, list):
            result["reason"] = "status.json に workers が無い"
            continue
        item = next((item for item in workers if isinstance(item, dict) and item.get("name") == worker), None)
        if item is None:
            result["reason"] = "status.json に worker が無い"
            continue
        stale = item.get("stale") is True
        verdict = item.get("verdict")
        if verdict not in ("stop", "reserve", "go", "boost", "unknown"):
            result["reason"] = "status.json の verdict が不正"
            continue
        result.update(source=source, stale=stale,
                      verdict=verdict if not stale else "unknown",
                      reason="" if item.get("reason") is None else item.get("reason"), remaining=item.get("remaining"),
                      resets_at=item.get("resets_at"))
        until = parse_datetime(item.get("burn_until"))
        if not stale and verdict == "boost" and result["reason"] == "burn" and until is not None and until < now:
            result.update(verdict="reserve", reason="burn_expired")
        return result
    return result


def agent_options(agent):
    try:
        with CONFIG.open(encoding="utf-8") as stream:
            config = json.load(stream)
    except FileNotFoundError:
        return {}
    if not isinstance(config, dict) or not isinstance(config.get("agents", {}), dict):
        raise ValueError("agent 設定が不正です")
    options = config.get("agents", {}).get(agent, {})
    if not isinstance(options, dict):
        raise ValueError("agent 設定が不正です")
    return options


def hook_log(agent, worker, verdict, decision):
    STATE.mkdir(parents=True, exist_ok=True)
    def clean(value):
        return str(value).replace("\n", " ").replace("\r", " ").replace("\t", " ")
    with (STATE / "hook.log").open("a", encoding="utf-8") as stream:
        stream.write("{} agent={} worker={} verdict={} decision={}\n".format(
            datetime.now(timezone.utc).isoformat(), clean(agent), clean(worker), clean(verdict), clean(decision)))


def allow_expiration(worker):
    try:
        until = parse_datetime(read_regular_text(STATE / "allow" / worker).strip())
        return until.astimezone(timezone.utc) if until is not None and until > datetime.now(timezone.utc) else None
    except (OSError, UnicodeError, ValueError, OverflowError):
        return None


def allow_active(worker):
    return allow_expiration(worker) is not None


OPENCODE_VALUE_FLAGS = {"--server", "--session", "-s", "--prompt", "--log-level", "--completions"}
OPENCODE_INTERACTIVE = {"run", "mini"}
OPENCODE_SUBCOMMANDS = {"upgrade", "update", "uninstall", "acp", "api", "debug", "auth", "mcp", "plugin", "models",
                        "stats", "mini", "run", "session", "service", "reload", "pair", "serve"}


OPENCODE_MANAGE_FLAGS = {"--help", "-h", "--version", "-v", "--wizard", "--completions"}


def opencode_launch(args):
    """OpenCode の起動の種類を返す。
    "launch": 対話起動（サブコマンドなし・ディレクトリ指定）と run・mini で、サーバーの指定がない。
    "private": 上と同じ起動で、--standalone が付いている（起動ごとの専用サーバー）。
    "other": 管理用のサブコマンド・--help などの管理用オプション・--server・--no-standalone・--standalone=。
    最初の -- より後ろはメッセージなので見ない。"""
    command = None
    skip = False
    private = False
    for arg in args:
        if arg == "--":
            break
        if skip:
            skip = False
            continue
        if arg == "--standalone":
            private = True
            continue
        if (arg in ("--no-standalone", "--server") or arg in OPENCODE_MANAGE_FLAGS or
                arg.startswith(("--server=", "--standalone=", "--completions="))):
            return "other"
        if arg in OPENCODE_VALUE_FLAGS:
            skip = True
        elif arg.startswith("-"):
            continue
        elif command is None:
            command = arg
    if command is not None and command in OPENCODE_SUBCOMMANDS and command not in OPENCODE_INTERACTIVE:
        return "other"
    return "private" if private else "launch"


def opendesign_key(options, env, launch):
    if "opendesign_key" not in options:
        return None
    if launch != "private":
        # 常駐サービス・別サーバー・管理用コマンドにはキーを渡さない（サービスが起動元の環境を受け継ぐため）。
        # 起動元の環境に既にあるキーも外す
        env.pop("OPENDESIGN_API_KEY", None)
        return "off(shared-server)"
    if "OPENDESIGN_API_KEY" in env:
        return "off(already-set)"
    settings = options["opendesign_key"]
    if not isinstance(settings, dict):
        return "off(command-failed)"
    worker = settings.get("worker")
    command = settings.get("command")
    if (not valid_worker(worker) or worker in (".", "..") or
            not isinstance(command, list) or not command or not command[0] or
            any(not isinstance(arg, str) for arg in command)):
        return "off(command-failed)"
    if read_verdict(worker)["verdict"] == "stop" and not allow_active(worker):
        return "off(stop)"
    try:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, start_new_session=True,
                                   env=child_environment())
        deadline = time.monotonic() + 15
        output = bytearray()
        failure = None
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while selector.get_map():
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        raise subprocess.TimeoutExpired(command, 15)
                    chunk = os.read(process.stdout.fileno(), 8192 + 1 - len(output))
                    if not chunk:
                        selector.unregister(process.stdout)
                    else:
                        output.extend(chunk)
                        if len(output) > 8192:
                            failure = "off(command-failed)"
                            break
            if failure is None:
                process.wait(timeout=max(0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            failure = "off(timeout)"
        except OSError:
            failure = "off(command-failed)"
        finally:
            if failure is not None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
            process.stdout.close()
        if failure is not None:
            return failure
        if process.returncode != 0:
            return "off(command-failed)"
        key = output.split(b"\n", 1)[0].rstrip(b"\r").decode("utf-8")
        if len(key) > 1024:
            return "off(command-failed)"
        if not key.strip():
            return "off(empty)"
        if "\x00" in key:
            return "off(command-failed)"
    except (OSError, ValueError, UnicodeError):
        return "off(command-failed)"
    env["OPENDESIGN_API_KEY"] = key
    return "on"


def hook_state(key, state):
    if not key:
        return None
    # Pane keys are normally safe filenames. Hash any unsafe key to keep state in its directory.
    if not re.fullmatch(r"[A-Za-z0-9_-]+", key) or len(key) > 200:
        key = hashlib.sha256(key.encode("utf-8")).hexdigest()[:16]
    directory = STATE / "hook"
    directory.mkdir(parents=True, exist_ok=True)
    cutoff = time.time() - 7 * 24 * 60 * 60
    for path in directory.glob("*.json"):
        try:
            if path.stat().st_mtime < cutoff:
                path.unlink()
        except FileNotFoundError:
            pass
    path = directory / (key + ".json")
    with (directory / (key + ".lock")).open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return None
        try:
            previous = json.loads(path.read_text(encoding="utf-8"))
        except (FileNotFoundError, ValueError, UnicodeError):
            previous = None
        path.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")
    return previous


def hook(agent):
    strict = agent in ("command-code", "devin")
    worker = None
    try:
        override = os.environ.get("ORCA_GATE_HOOK", "")
        pane = os.environ.get("ORCA_PANE_KEY", "")
        if not pane or override == "off":
            return 0
        if override and not valid_worker(override):
            return 0
        options = agent_options(agent)
        strict = options.get("hook_block_unknown", strict) is True
        if options.get("hook") is False:
            return 0
        worker = override if override else options.get("worker", DEFAULT_WORKERS.get(agent))
        if not override and options.get("off") is True:
            worker = None
        if not valid_worker(worker):
            return 0
        sys.stdin.buffer.read(1024 * 1024)
        result = read_verdict(worker)
        verdict = result["verdict"]
        allowed = allow_active(worker) if verdict in ("stop", "unknown") or result["stale"] else False
        blocked = (verdict == "stop" or ((verdict == "unknown" or result["stale"]) and strict)) and not allowed
        state = {"worker": worker, "verdict": verdict, "allowed": allowed}
        try:
            previous = hook_state(pane, state)
        except Exception:
            previous = None
        if blocked:
            message("残量の判定が {}（worker: {}・理由: {}）になったため、この入力は送信していません。端末と会話はそのままです。回復後に同じ入力を送り直してください。一時的に通すには orca-agent-gate allow {} [分]".format(verdict, worker, result["reason"], worker))
            try:
                hook_log(agent, worker, verdict, "block")
            except Exception:
                pass
            return 2
        if (verdict in ("reserve", "unknown") or allowed) and previous != state:
            suffix = "（一時許可中）" if allowed else ""
            print(json.dumps({"systemMessage": "残量の判定は {}（worker: {}・理由: {}）です{}。".format(verdict, worker, result["reason"], suffix)}, ensure_ascii=False))
            try:
                hook_log(agent, worker, verdict, "warn")
            except Exception:
                pass
        return 0
    except Exception as exc:
        if strict:
            message("残量の判定を確認できないため、この入力は送信していません。端末と会話はそのままです。回復後に同じ入力を送り直してください。")
            try:
                hook_log(agent, worker or "-", "unknown", "block")
            except Exception:
                pass
            return 2
        return 0


def allow_command(args):
    if len(args) not in (1, 2) or not valid_worker(args[0]):
        message("使い方: orca-agent-gate allow <worker> [分|off]")
        return 2
    path = STATE / "allow" / args[0]
    if len(args) == 2 and args[1] == "off":
        path.unlink(missing_ok=True)
        return 0
    try:
        minutes = int(args[1]) if len(args) == 2 else 60
        if not 1 <= minutes <= 720:
            raise ValueError
    except ValueError:
        message("分は 1 から 720 の整数にしてください")
        return 2
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text((datetime.now(timezone.utc) + timedelta(minutes=minutes)).isoformat() + "\n", encoding="utf-8")
    return 0


def dispatch(argv):
    if len(argv) > 1 and argv[1] == "verdict":
        if len(argv) != 3 or not valid_worker(argv[2]):
            message("使い方: orca-agent-gate verdict <worker>")
            return 2
        result = read_verdict(argv[2])
        until = allow_expiration(argv[2])
        result["allowed"] = until is not None
        if until is not None:
            result["allow_until"] = until.isoformat()
        for key, value in list(result.items()):
            if isinstance(value, float) and not math.isfinite(value):
                result[key] = None
            elif key in ("reason", "allow_until") and value is not None and not isinstance(value, str):
                result[key] = str(value)[:200]
            elif isinstance(value, str) and len(value) > 200:
                result[key] = value[:200]
            elif key != "allowed" and not isinstance(value, (str, int, float, bool, type(None))):
                result[key] = str(value)[:200]
        print(json.dumps(result, ensure_ascii=False, allow_nan=False))
        return 0
    if len(argv) > 1 and argv[1] == "hook":
        if len(argv) != 3 or not re.fullmatch(r"[a-z0-9-]+", argv[2]):
            return 0
        return hook(argv[2])
    if len(argv) > 1 and argv[1] == "allow":
        try:
            return allow_command(argv[2:])
        except OSError as exc:
            message("一時許可を更新できません: {}".format(exc))
            return 2
    return main(argv)

def main(argv):
    agent = argv[1] if len(argv) > 1 else "-"
    worker = None
    check = "not-run"
    decision = "error"
    pid_file = None
    try:
        if os.environ.get("ORCA_AGENT_GATE_PID") == str(os.getpid()):
            raise ValueError("ラッパーへの再入を検出しました")
        os.environ["ORCA_AGENT_GATE_PID"] = str(os.getpid())
        if len(argv) < 2:
            raise ValueError("使い方: orca-agent-gate <agent-id> [引数...]")
        if not re.fullmatch(r"[a-z0-9-]+", agent):
            raise ValueError("agent ID は英小文字・数字・ハイフンのみ使用できます")
        try:
            with CONFIG.open(encoding="utf-8") as stream:
                config = json.load(stream)
        except FileNotFoundError:
            config = {}
        if not isinstance(config, dict) or not isinstance(config.get("agents", {}), dict):
            raise ValueError("設定は agents を含む JSON オブジェクトにしてください")
        options = config.get("agents", {}).get(agent, {})
        if not isinstance(options, dict):
            raise ValueError("agent の設定は JSON オブジェクトにしてください")
        worker = options.get("worker", DEFAULT_WORKERS.get(agent))
        if worker is not None and (not valid_worker(worker) or worker in (".", "..")):
            raise ValueError("worker は英数字・記号 . _ - の 1〜40 文字（先頭の -、off、.、.. を除く）にしてください")
        off = options.get("off", False)
        if not isinstance(off, bool):
            message("agent の off は真偽値ではないため false として扱います")
        if off is True:
            worker = None
        cap = options.get("cap")
        if cap is not None and (isinstance(cap, bool) or not isinstance(cap, int) or cap < 1):
            raise ValueError("cap は 1 以上の整数にしてください")
        board_keys = options.get("board_keys", [])
        if (not isinstance(board_keys, list) or
                any(not isinstance(key, str) or not key for key in board_keys) or
                len(set(board_keys)) != len(board_keys)):
            raise ValueError("board_keys は重複のない文字列の配列にしてください")
        if worker:
            cap, board_keys = worker_limits(agent, worker, options, config.get("agents", {}))
        force = os.environ.pop("ORCA_GATE_FORCE", "") == "1"
        if force:
            message("強制起動します")
            check = "force"
        args = argv[2:]
        added_model = None
        if (agent == "command-code" and options.get("auto_model") is not False and
                command_code_needs_model(args)):
            added_model = command_code_model()
            args = ["-m", added_model] + args
        launch = opencode_launch(args)
        standalone = options.get("standalone", False)
        if not isinstance(standalone, bool):
            message("agent の standalone は真偽値ではないため false として扱います")
        elif standalone and launch == "launch":
            # OpenCode 2.x は既定で常駐サービスにつなぐ。ここで渡す環境変数（キー・ORCA_PANE_KEY）と
            # プラグインを効かせるには、起動ごとに専用のサーバーを立てる --standalone が要る
            args = ["--standalone"] + args
            launch = "private"
        if agent == "devin":
            args = model_args(args, config, force)
            if args is None:
                decision = "stop-model"
                stop("許可されていない Devin モデルのため起動を止めました", allow_off=False)
                return 3
        executable = options.get("cli")
        if executable is not None:
            if not isinstance(executable, str) or not os.path.isabs(executable) or not os.path.isfile(executable) or not os.access(executable, os.X_OK) or os.path.samefile(executable, __file__):
                raise ValueError("設定した CLI の絶対パスが無効、実行不可、またはラッパー自身です")
        else:
            executable = find_executable("opencode" if agent == "opencode2" else agent, exclude_self=True)
            if not executable:
                raise ValueError("本物の CLI が PATH に見つかりません: {}".format(agent))
        if worker and not force:
            check = quota_check(worker)
            if check == "stop":
                decision = "stop-quota"
                return 3
        if worker and cap is not None and not force:
            pid_file = register(worker, cap, board_keys)
            if pid_file is None:
                decision = "stop-cap"
                stop("同時起動数の上限に達したため起動を止めました")
                return 3
        exec_env = os.environ.copy()
        opendesign = opendesign_key(options, exec_env, launch)
        decision = "exec"
        log(agent, worker, check, decision, added_model, opendesign)
        if os.environ.get("ORCA_GATE_HOOK") != "off":
            if force:
                exec_env["ORCA_GATE_HOOK"] = "off"
            elif worker:
                exec_env["ORCA_GATE_HOOK"] = worker
            else:
                exec_env.pop("ORCA_GATE_HOOK", None)
        os.execve(executable, [executable] + args, exec_env)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        message("起動できません: {}".format(exc))
        if pid_file is not None:
            pid_file.unlink(missing_ok=True)
        if decision != "exec":
            log(agent, worker, check, "error")
        return 2
    finally:
        if decision.startswith("stop"):
            log(agent, worker, check, decision)


if __name__ == "__main__":
    sys.exit(dispatch(sys.argv))
